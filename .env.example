# Copy this file to .env and fill in real values. Never commit .env.

# Riot Games API key (developer keys expire every 24h — regenerate as needed)
RIOT_API_KEY=

# Anthropic API key (used in later phases for AI-generated coaching reports)
ANTHROPIC_API_KEY=

# Player identity (Riot ID format: gameName#tagLine)
RIOT_GAME_NAME=HelloKittler
RIOT_TAG_LINE=meow
RIOT_REGION=NA
