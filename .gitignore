# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Secrets
.env

# Match data — private, regenerable via Riot API
data/raw_matches/*
!data/raw_matches/.gitkeep
data/database/*
!data/database/.gitkeep

# Generated reports — private, regenerable
reports/generated_reports/*
!reports/generated_reports/.gitkeep

# Published draft runtime state — private, regenerable (src/runtime/state_publisher.py)
reports/runtime/*
!reports/runtime/.gitkeep

# Sanitized real champ-select captures (src/draft/capture.py) -- best-effort
# sanitized, not a guarantee; never commit without a manual review, per the
# warning baked into every captured file itself.
reports/captures/*
!reports/captures/.gitkeep

# OS
.DS_Store
Thumbs.db
